# Research & internal planning docs — kept local, not part of the public product.
# Two exceptions are published, because a reader cannot check our claims without them:
# the ADRs (why each decision was made) and the benchmarking methodology (how every
# published number is produced).
docs/*
!docs/adr/
!docs/cachet-benchmarking.md

# Build output
/bin/
/dist/
/target/
*.exe
*.test
*.out

# Go
vendor/

# Rust
Cargo.lock.orig

# Environment & secrets
.env
.env.*
!.env.example
*.pem
*.key

# Local infra state
.data/
data/
*.db
*.sqlite

# Benchmark artifacts (regenerate; don't version)
bench/results/
*.prof
*.pprof

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Docs site build output. The site is source; its artefacts are not.
web/node_modules/
web/.next/
web/.source/
web/out/
web/next-env.d.ts

# The chaos suite's raw records. FAULTS.md is the artifact and is committed; the JSON behind it is
# per-run (counts and ports differ every time), so committing it would make every run a diff.
test/chaos/testdata/
.gstack/

.claude/

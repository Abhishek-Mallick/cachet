# Copy to .env and adjust. Never commit .env.
MYSQL_ROOT_PASSWORD=cachet
MYSQL_DATABASE=cachet

# Host ports. Offset from the defaults so a local MySQL/Redis does not collide.
SHARD0_PORT=3316
SHARD1_PORT=3317
SHARD2_PORT=3318
CACHE_PORT=6379

# Pin these when recording a benchmark; docs/cachet-benchmarking.md requires published digests.
PERCONA_TAG=8.0
VALKEY_TAG=8-alpine

GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
